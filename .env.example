PORT=3000
NODE_ENV=development

# PostgreSQL Connection (Dedicated Pincode-API container on port 5433)
DATABASE_URL=postgresql://pincode_user:pincode_password@localhost:5433/pincode_db

# Redis Connection (Dedicated Pincode-API redis on port 6379)
REDIS_URL=redis://localhost:6379

# API Keys (Comma-separated list of valid backend API keys)
API_KEYS=pincode_dev_secret_key_12345,partner_prod_api_key_88321

# Cache TTL in seconds (Default: 86400 = 24 hours)
CACHE_TTL_SECONDS=86400

# Rate Limiting (1000 requests per 15 minutes by default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
